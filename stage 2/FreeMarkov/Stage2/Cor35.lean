/-
Free Markov categories, Stage 2: the congruence `E_T` and Corollary 3.5 (`S_T = E_T`).

"Let `E_T` be the monoidal congruence relation on `F_s(G)` generated by the pairs
`([Ω, u], [Λ, w])`, where `((Ω, u) / (Λ, w), α, β)` runs through the templates in `T`
with any chosen orderings on the domains and codomains of `Ω`, `Λ` that are compatible
with `α`, `β`."

`S_T ⊆ E_T` uses Lemma 3.3 with the orderings of `Ω^♯ = Ω ⊎ R` chosen as an ordering of
`Ω` followed by one of `R`, so that `[Ω^♯] = [Ω] ⊗ [R]` (no cited result).  `E_T ⊆ S_T` is
the induction on how `E_T` is generated: a generating pair is a surgery on the whole
diagram, and `S_T` is a monoidal congruence (which uses C1).
-/
module

public import FreeMarkov.Stage2.Quotient

@[expose] public section

universe u w v u₁ u₂ u₃

namespace FreeMarkov

open CategoryTheory Relation Diagram

variable {S : Type w} {G : FreeGraphMonoid.{w, v} S}

namespace Diagram

variable {NK : Type u₁} {EK : Type u₂} (K : PDiagram G NK EK) {R : Type u₃} (r : R → S)
  (d₀ : Enumeration K.IsDom) (c₀ : Enumeration K.IsCod) (ρ : Enumeration fun _ : R => True)

/-- The node-free diagram on `R` with the same ordering `ρ` on its domain and codomain. -/
def nodeFreeOf : Diagram G Empty R :=
  nodeFree r ρ.list ρ.list ρ.nodup (fun e => (ρ.mem_iff e).2 trivial) ρ.nodup
    (fun e => (ρ.mem_iff e).2 trivial)

/-- `[Ω ⊎ R] = [Ω] ⊗ [R]` when `R` is ordered after `Ω` on both sides. -/
noncomputable def plusIso :
    ((K.addLoose r).anchor (d₀.plus ρ) (c₀.plusc ρ)).Iso ((K.anchor d₀ c₀).tensor (nodeFreeOf r ρ)) :=
  Diagram.Iso.ofProj Sum.inl id id id Sum.inl_injective Function.injective_id
    Function.injective_id Function.injective_id
    (fun t => ⟨fun ⟨n, h⟩ => ⟨_, h⟩, fun ⟨n, h⟩ => by
      subst h
      rcases n with n | n
      · exact ⟨n, rfl⟩
      · exact n.elim⟩)
    (fun t => ⟨fun ⟨n, h⟩ => ⟨_, h⟩, fun ⟨n, h⟩ => ⟨_, h⟩⟩)
    (by
      rintro z n' rfl
      simp [Diagram.tensor, AGraph.tensor, PGraph.tensor, PDiagram.anchor, AGraph.ofPGraph])
    (by
      rintro z n' rfl
      simp [Diagram.tensor, AGraph.tensor, PGraph.tensor, PDiagram.anchor, AGraph.ofPGraph])
    (by
      change (d₀.plus ρ).list.map id = (d₀.list.map Sum.inl ++ ρ.list.map Sum.inr).map id
      rw [Enumeration.plus_list])
    (by
      change (c₀.plusc ρ).list.map id = (c₀.list.map Sum.inl ++ ρ.list.map Sum.inr).map id
      rw [Enumeration.plusc_list])
    (by rintro (e | e) e' rfl <;> rfl)
    (by rintro z n' rfl; rfl)

/-- `Ω ⊎ ∅ = Ω`. -/
noncomputable def addLooseEmptyIso (r : PEmpty.{u₃ + 1} → S)
    (ρ : Enumeration fun _ : PEmpty.{u₃ + 1} => True) :
    ((K.addLoose r).anchor (d₀.plus ρ) (c₀.plusc ρ)).Iso (K.anchor d₀ c₀) := by
  have hρ : ρ.list = [] := List.eq_nil_iff_forall_not_mem.2 fun e => e.elim
  exact Diagram.Iso.ofProj id (Sum.elim id fun e => e.elim) id id Function.injective_id
    Function.injective_id
    (by rintro (e | e) (e' | e') h; exacts [congrArg _ h, e'.elim, e.elim, e.elim])
    Function.injective_id
    (fun t => ⟨fun ⟨n, h⟩ => ⟨_, h⟩, fun ⟨n, h⟩ => ⟨_, h⟩⟩)
    (fun t => ⟨fun ⟨n, h⟩ => ⟨_, h⟩, fun ⟨n, h⟩ => ⟨.inl n, h⟩⟩)
    (by
      rintro z n' rfl
      simp [PDiagram.anchor, AGraph.ofPGraph, List.map_map, Function.comp_def])
    (by
      rintro z n' rfl
      simp [PDiagram.anchor, AGraph.ofPGraph, List.map_map, Function.comp_def])
    (by
      change (d₀.plus ρ).list.map _ = d₀.list.map id
      rw [Enumeration.plus_list, hρ]
      simp [Function.comp_def])
    (by
      change (c₀.plusc ρ).list.map _ = c₀.list.map id
      rw [Enumeration.plusc_list, hρ]
      simp [Function.comp_def])
    (by rintro (e | e) e' rfl; exacts [rfl, e.elim])
    (by rintro z n' rfl; rfl)

end Diagram

/-- **`E_T`**: the monoidal congruence relation on `F_s(G)` generated by the pairs
`([Ω, u], [Λ, w])` for the templates in `T`, with orderings of the domains and codomains
of `Ω`, `Λ` compatible with `α`, `β` (that is, `α` carries the ordering of `dom(Λ)` to
that of `dom(Ω)`, and `β` that of `cod(Λ)` to that of `cod(Ω)`). -/
inductive ERel (T : Set (Template.{u} G)) : DClass G → DClass G → Prop
  | gen {τ : Template.{u} G} (hτ : τ ∈ T) (dΩ : Enumeration τ.Ω.IsDom) (cΩ : Enumeration τ.Ω.IsCod)
      (dΛ : Enumeration τ.Λ.IsDom) (cΛ : Enumeration τ.Λ.IsCod) (hd : dΛ.mapEquiv τ.α = dΩ)
      (hc : cΛ.mapEquiv τ.β = cΩ) :
      ERel T (DClass.mk (τ.Ω.anchor dΩ cΩ)) (DClass.mk (τ.Λ.anchor dΛ cΛ))
  | refl (c : DClass G) : ERel T c c
  | symm {c d : DClass G} : ERel T c d → ERel T d c
  | trans {c d e : DClass G} : ERel T c d → ERel T d e → ERel T c e
  | tensor {c c' d d' : DClass G} : ERel T c c' → ERel T d d' → ERel T (c.tensor d) (c'.tensor d')
  | comp {c c' d d' : DClass G} : ERel T c c' → ERel T d d' → c.cod = d.dom → c'.cod = d'.dom →
      ERel T (c.comp d) (c'.comp d')

variable {T : Set (Template.{u} G)}

/-- `E_T` relates parallel morphisms only. -/
theorem ERel.dom_eq_cod_eq {c d : DClass G} (h : ERel T c d) : d.dom = c.dom ∧ d.cod = c.cod := by
  induction h with
  | @gen τ hτ dΩ cΩ dΛ cΛ hd hc =>
    subst hd hc
    simp only [DClass.dom_mk, DClass.cod_mk, domWord, codWord]
    exact ⟨congrArg FreeMonoid.ofList (Enumeration.map_mapEquiv dΛ τ.α _ _ τ.hα).symm,
      congrArg FreeMonoid.ofList (Enumeration.map_mapEquiv cΛ τ.β _ _ τ.hβ).symm⟩
  | refl => exact ⟨rfl, rfl⟩
  | symm _ ih => exact ⟨ih.1.symm, ih.2.symm⟩
  | trans _ _ ih ih' => exact ⟨ih'.1.trans ih.1, ih'.2.trans ih.2⟩
  | tensor _ _ ih ih' => simp only [DClass.dom_tensor, DClass.cod_tensor, ih.1, ih.2, ih'.1, ih'.2,
      and_self]
  | comp _ _ h h' ih ih' => exact ⟨by rw [DClass.dom_comp h, DClass.dom_comp h', ih.1],
      by rw [DClass.cod_comp h, DClass.cod_comp h', ih'.2]⟩

/-- A `T`-surgery step is in `E_T` ("`S_T ⊆ E_T` is an easy consequence of Lemma 3.3"). -/
theorem TStep.toERel {N E : Type} [Finite N] [Finite E] {N' : Type u₁} {E' : Type u₂}
    [Finite N'] [Finite E'] {Γ : Diagram G N E} {Ξ : Diagram G N' E'} (h : TStep T Γ Ξ) :
    ERel T (DClass.mk Γ) (DClass.mk Ξ) := by
  obtain ⟨τ, hτ, A, hA, φ, ⟨i⟩⟩ := h
  set V := hA.sharpLayer
  let d₀ : Enumeration τ.Ω.IsDom := Enumeration.ofFinite _
  let c₀ : Enumeration τ.Ω.IsCod := Enumeration.ofFinite _
  let ρ : Enumeration fun _ : V.R => True := Enumeration.ofFinite _
  have e₁ := Γ.mk_eq_decomp V φ (d₀.plus ρ) (c₀.plusc ρ)
  have e₂ := Γ.mk_surgeryAt_eq_decomp V φ τ.α τ.β τ.hα τ.hβ (d₀.plus ρ) (c₀.plusc ρ)
  have hM : DClass.mk (Γ.midΩ V (d₀.plus ρ) (c₀.plusc ρ)) =
      (DClass.mk (τ.Ω.anchor d₀ c₀)).tensor (DClass.mk (nodeFreeOf (Γ.rLabel V) ρ)) := by
    rw [DClass.mk_tensor]
    exact DClass.mk_eq_mk (plusIso _ _ _ _ _)
  have hMΛ : DClass.mk (Γ.midΛ V τ.α τ.β (d₀.plus ρ) (c₀.plusc ρ)) =
      (DClass.mk (τ.Λ.anchor (d₀.mapEquiv τ.α.symm) (c₀.mapEquiv τ.β.symm))).tensor
        (DClass.mk (nodeFreeOf (Γ.rLabel V) ρ)) := by
    change DClass.mk ((τ.Λ.addLoose (Γ.rLabel V)).anchor
      ((d₀.plus ρ).mapEquiv (PGraph.liftDom τ.α V.R).symm)
      ((c₀.plusc ρ).mapEquiv (PGraph.liftCod τ.β V.R).symm)) = _
    rw [← Enumeration.plus_liftDom, ← Enumeration.plusc_liftCod, DClass.mk_tensor]
    exact DClass.mk_eq_mk (plusIso _ _ _ _ _)
  have hgen : ERel T (DClass.mk (τ.Ω.anchor d₀ c₀))
      (DClass.mk (τ.Λ.anchor (d₀.mapEquiv τ.α.symm) (c₀.mapEquiv τ.β.symm))) :=
    ERel.gen hτ d₀ c₀ _ _ (by rw [Enumeration.mapEquiv_mapEquiv, Equiv.symm_trans_self,
      Enumeration.mapEquiv_refl]) (by rw [Enumeration.mapEquiv_mapEquiv, Equiv.symm_trans_self,
      Enumeration.mapEquiv_refl])
  have ht := ERel.tensor hgen (ERel.refl (DClass.mk (nodeFreeOf (Γ.rLabel V) ρ)))
  rw [← hM, ← hMΛ] at ht
  have hgM : (DClass.mk (Γ.lowerA V φ (d₀.plus ρ))).cod =
      (DClass.mk (Γ.midΩ V (d₀.plus ρ) (c₀.plusc ρ))).dom := by
    rw [DClass.cod_mk, DClass.dom_mk]
    exact Γ.lowerA_codWord V φ _ _
  have hMh : (DClass.mk (Γ.midΩ V (d₀.plus ρ) (c₀.plusc ρ))).cod =
      (DClass.mk (Γ.upperA V φ (c₀.plusc ρ))).dom := by
    rw [DClass.cod_mk, DClass.dom_mk]
    exact Γ.midΩ_codWord V φ _ _
  have hpar := ht.dom_eq_cod_eq
  rw [e₁, ← DClass.mk_eq_mk i, e₂]
  refine ERel.comp (ERel.comp (ERel.refl _) ht hgM (hgM.trans hpar.1.symm)) (ERel.refl _) ?_ ?_
  · rw [DClass.cod_comp hgM]
    exact hMh
  · rw [DClass.cod_comp (hgM.trans hpar.1.symm), hpar.2]
    exact hMh

/-- A generating pair of `E_T` is a `T`-surgery (on the whole diagram). -/
theorem SRel.of_gen (J : JoyalStreet G) {τ : Template.{u} G}
    (hτ : τ ∈ T) (dΩ : Enumeration τ.Ω.IsDom) (cΩ : Enumeration τ.Ω.IsCod)
    (dΛ : Enumeration τ.Λ.IsDom) (cΛ : Enumeration τ.Λ.IsCod) (hd : dΛ.mapEquiv τ.α = dΩ)
    (hc : cΛ.mapEquiv τ.β = cΩ) :
    SRel T (DClass.mk (τ.Ω.anchor dΩ cΩ)) (DClass.mk (τ.Λ.anchor dΛ cΛ)) := by
  have hdΛ : dΛ = dΩ.mapEquiv τ.α.symm := by rw [← hd, Enumeration.mapEquiv_symm]
  have hcΛ : cΛ = cΩ.mapEquiv τ.β.symm := by rw [← hc, Enumeration.mapEquiv_symm]
  subst hdΛ hcΛ
  let ρ : Enumeration fun _ : PEmpty.{1} => True := Enumeration.ofFinite _
  let r : PEmpty.{1} → S := fun e => e.elim
  let iΩ := addLooseEmptyIso τ.Ω dΩ cΩ r ρ
  let iΛ := addLooseEmptyIso τ.Λ (dΩ.mapEquiv τ.α.symm) (cΩ.mapEquiv τ.β.symm) r ρ
  have hdomΛ : (τ.Λ.anchor (dΩ.mapEquiv τ.α.symm) (cΩ.mapEquiv τ.β.symm)).domWord =
      (τ.Ω.anchor dΩ cΩ).domWord :=
    congrArg FreeMonoid.ofList (Enumeration.map_mapEquiv dΩ τ.α.symm _ _ (symm_v₀ τ.α τ.hα))
  have hcodΛ : (τ.Λ.anchor (dΩ.mapEquiv τ.α.symm) (cΩ.mapEquiv τ.β.symm)).codWord =
      (τ.Ω.anchor dΩ cΩ).codWord :=
    congrArg FreeMonoid.ofList (Enumeration.map_mapEquiv cΩ τ.β.symm _ _ (symm_v₀' τ.β τ.hβ))
  refine SRel.of_tStep (TDecomp.tStep ⟨τ, hτ, PEmpty, inferInstance, r, dΩ.plus ρ, cΩ.plusc ρ,
    DClass.mk (idD G (τ.Ω.anchor dΩ cΩ).domWord), DClass.mk (idD G (τ.Ω.anchor dΩ cΩ).codWord),
    ?_, ?_, ?_, ?_⟩)
  · rw [DClass.cod_mk, idD_codWord]
    exact iΩ.domWord_eq
  · rw [DClass.dom_mk, idD_domWord]
    exact iΩ.codWord_eq.symm
  · rw [DClass.mk_eq_mk iΩ]
    have h₁ := J.cls_id_comp (DClass.mk (τ.Ω.anchor dΩ cΩ))
    have h₂ := J.cls_comp_id (DClass.mk (τ.Ω.anchor dΩ cΩ))
    rw [DClass.dom_mk] at h₁
    rw [DClass.cod_mk] at h₂
    rw [h₁, h₂]
  · rw [← Enumeration.plus_liftDom, ← Enumeration.plusc_liftCod, DClass.mk_eq_mk iΛ]
    have h₁ := J.cls_id_comp (DClass.mk (τ.Λ.anchor (dΩ.mapEquiv τ.α.symm) (cΩ.mapEquiv τ.β.symm)))
    have h₂ := J.cls_comp_id (DClass.mk (τ.Λ.anchor (dΩ.mapEquiv τ.α.symm) (cΩ.mapEquiv τ.β.symm)))
    rw [DClass.dom_mk, hdomΛ] at h₁
    rw [DClass.cod_mk, hcodΛ] at h₂
    rw [h₁, h₂]

/-- **Corollary 3.5.** `S_T = E_T`. -/
theorem cor_3_5 (J : JoyalStreet G) (hT : Template.IsSymmetric T) (c d : DClass G) :
    SRel T c d ↔ ERel T c d := by
  constructor
  · rintro ⟨a, b, rfl, rfl, h⟩
    induction h with
    | refl => exact ERel.refl _
    | @tail b c _ hbc ih =>
      refine ih.trans ?_
      rw [DClass.mk_fin b, DClass.mk_fin c]
      exact TStep.toERel hbc
  · intro h
    induction h with
    | gen hτ dΩ cΩ dΛ cΛ hd hc => exact SRel.of_gen J hτ dΩ cΩ dΛ cΛ hd hc
    | refl c => exact SRel.refl c
    | symm _ ih => exact ih.symm hT.symm_mem
    | trans _ _ ih ih' => exact ih.trans hT.empty_mem ih'
    | tensor _ _ ih ih' => exact SRel.tensor J hT ih ih'
    | comp _ _ h _ ih ih' => exact SRel.comp J hT ih ih' h

end FreeMarkov
