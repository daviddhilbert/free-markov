/-
Free Markov categories, Stage 3: Remark 4.2 as a theorem.

"In terms of coherence, freeness may be reformulated as follows. A well-formed equation
between morphisms in the symbolic language of symmetric monoidal categories follows from
the axioms of Markov categories if and only if it holds, up to Markov surgeries, in the
graphical language of symmetric monoidal categories."

The symbolic language is the syntactic free symmetric strict monoidal category `Syn_s(G)`
of Stage 0.  In it, duplicates and discards on words are expressed through those on the
letters by (1.2) (`copyS`, `discardS`), and `MarkovCong` is the congruence on `Syn_s(G)`
(an equivalence relation on morphisms compatible with `∘` and `⊗`, stated on `Arrow` so
that no casts enter) generated by the instances of (1.1), (1.2) and (1.3).

* `remark_4_2`: `f ≡ g` modulo `MarkovCong` iff the diagrams `[f]`, `[g]` of `f`, `g` (C1)
  are `S_M`-equivalent, i.e. have the same image in `F_s(G) / S_M`; with
  `remark_4_2_surjective`, the quotient `Syn_s(G) / MarkovCong` is isomorphic to
  `F_s(G) / S_M` (identity on objects, bijective on morphisms).
* `remark_4_2_semantic`: `f ≡ g` modulo `MarkovCong` iff `f` and `g` have the same value
  under every interpretation of `G` in a strict Markov category that matches duplicates and
  discards.
-/
module

public import FreeMarkov.Stage3.Theorem41

@[expose] public section

universe w v u₁ v₁

namespace FreeMarkov

open CategoryTheory StrictSMC StrictMarkov FreeGraphMonoid

variable {S : Type w}

namespace FreeDDGraphMonoid

variable (G : FreeDDGraphMonoid.{w, v} S)

/-! ### Duplicates and discards on words in `Syn_s(G)` -/

/-- The duplicate on a letter, as a morphism `a → aa` of `Syn_s(G)`. -/
noncomputable def dupS (x : S) : Syn.of G.toFreeGraphMonoid (FreeMonoid.of x) ⟶
    Syn.of G.toFreeGraphMonoid (FreeMonoid.of x) * Syn.of G.toFreeGraphMonoid (FreeMonoid.of x) :=
  eqToHom (congrArg (Syn.of G.toFreeGraphMonoid) (G.s_dup x).symm) ≫ Syn.gen (G.dup x) ≫
    eqToHom (by exact congrArg (Syn.of G.toFreeGraphMonoid) (G.t_dup x) :
      Syn.of G.toFreeGraphMonoid (G.t (G.dup x)) =
        Syn.of G.toFreeGraphMonoid (FreeMonoid.of x) * Syn.of G.toFreeGraphMonoid (FreeMonoid.of x))

/-- The discard on a letter, as a morphism `a → 1` of `Syn_s(G)`. -/
noncomputable def discS (x : S) : Syn.of G.toFreeGraphMonoid (FreeMonoid.of x) ⟶
    Syn.of G.toFreeGraphMonoid 1 :=
  eqToHom (congrArg (Syn.of G.toFreeGraphMonoid) (G.s_disc x).symm) ≫ Syn.gen (G.disc x) ≫
    eqToHom (congrArg (Syn.of G.toFreeGraphMonoid) (G.t_disc x))

/-- The duplicate on a word of `Syn_s(G)`, expressed through those on its letters by (1.2):
`δ_1 = 1_1`, `δ_a` the generator for a letter `a`, and
`δ_{a w} = (1_a ⊗ σ_{a,w} ⊗ 1_w) ∘ (δ_a ⊗ δ_w)`. -/
noncomputable def copyL : (l : List S) → Syn.of G.toFreeGraphMonoid (FreeMonoid.ofList l) ⟶
    Syn.of G.toFreeGraphMonoid (FreeMonoid.ofList l) * Syn.of G.toFreeGraphMonoid (FreeMonoid.ofList l)
  | [] => 𝟙 (Syn.of G.toFreeGraphMonoid 1)
  | [x] => G.dupS x
  | x :: y :: l =>
    ((G.dupS x ⊗ₛ copyL (y :: l)) ≫
      eqToHom (by simp only [mul_assoc] :
        Syn.of G.toFreeGraphMonoid (FreeMonoid.of x) * Syn.of G.toFreeGraphMonoid (FreeMonoid.of x) *
          (Syn.of G.toFreeGraphMonoid (FreeMonoid.ofList (y :: l)) *
            Syn.of G.toFreeGraphMonoid (FreeMonoid.ofList (y :: l))) =
        Syn.of G.toFreeGraphMonoid (FreeMonoid.of x) * (Syn.of G.toFreeGraphMonoid (FreeMonoid.of x) *
          Syn.of G.toFreeGraphMonoid (FreeMonoid.ofList (y :: l))) *
            Syn.of G.toFreeGraphMonoid (FreeMonoid.ofList (y :: l))) ≫
      ((𝟙 (Syn.of G.toFreeGraphMonoid (FreeMonoid.of x)) ⊗ₛ
        σ_ (Syn.of G.toFreeGraphMonoid (FreeMonoid.of x))
          (Syn.of G.toFreeGraphMonoid (FreeMonoid.ofList (y :: l)))) ⊗ₛ
        𝟙 (Syn.of G.toFreeGraphMonoid (FreeMonoid.ofList (y :: l))))) ≫
      eqToHom (by exact (by simp only [mul_assoc] :
        Syn.of G.toFreeGraphMonoid (FreeMonoid.of x) * (Syn.of G.toFreeGraphMonoid
          (FreeMonoid.ofList (y :: l)) * Syn.of G.toFreeGraphMonoid (FreeMonoid.of x)) *
            Syn.of G.toFreeGraphMonoid (FreeMonoid.ofList (y :: l)) =
        Syn.of G.toFreeGraphMonoid (FreeMonoid.of x) *
          Syn.of G.toFreeGraphMonoid (FreeMonoid.ofList (y :: l)) *
          (Syn.of G.toFreeGraphMonoid (FreeMonoid.of x) *
            Syn.of G.toFreeGraphMonoid (FreeMonoid.ofList (y :: l)))) :
        Syn.of G.toFreeGraphMonoid (FreeMonoid.of x) * (Syn.of G.toFreeGraphMonoid
          (FreeMonoid.ofList (y :: l)) * Syn.of G.toFreeGraphMonoid (FreeMonoid.of x)) *
            Syn.of G.toFreeGraphMonoid (FreeMonoid.ofList (y :: l)) =
        Syn.of G.toFreeGraphMonoid (FreeMonoid.ofList (x :: y :: l)) *
          Syn.of G.toFreeGraphMonoid (FreeMonoid.ofList (x :: y :: l)))

/-- The discard on a word of `Syn_s(G)`: `ε_{a_1 ⋯ a_n} = ε_{a_1} ⊗ ⋯ ⊗ ε_{a_n}`. -/
noncomputable def discardL : (l : List S) → Syn.of G.toFreeGraphMonoid (FreeMonoid.ofList l) ⟶
    Syn.of G.toFreeGraphMonoid 1
  | [] => 𝟙 (Syn.of G.toFreeGraphMonoid 1)
  | [x] => G.discS x
  | x :: y :: l => G.discS x ⊗ₛ discardL (y :: l)

/-- `δ_a` in `Syn_s(G)`. -/
noncomputable def copyS (a : G.toFreeGraphMonoid.Syn) : a ⟶ a * a :=
  G.copyL (FreeMonoid.toList a)

/-- `ε_a` in `Syn_s(G)`. -/
noncomputable def discardS (a : G.toFreeGraphMonoid.Syn) : a ⟶ 1 :=
  G.discardL (FreeMonoid.toList a)

/-- **The congruence on `Syn_s(G)` generated by the axioms of Markov categories**: the
smallest equivalence relation on morphisms (in `Arrow`) that is compatible with `∘` and `⊗`
and contains the instances of (1.1), (1.2) for all words and of (1.3) for all morphisms. -/
inductive MarkovCong : Arrow G.toFreeGraphMonoid.Syn → Arrow G.toFreeGraphMonoid.Syn → Prop
  | refl (p) : MarkovCong p p
  | symm {p q} : MarkovCong p q → MarkovCong q p
  | trans {p q r} : MarkovCong p q → MarkovCong q r → MarkovCong p r
  | comp {a b c a' b' c' : G.toFreeGraphMonoid.Syn} {f : a ⟶ b} {g : b ⟶ c} {f' : a' ⟶ b'}
      {g' : b' ⟶ c'} : MarkovCong (Arrow.mk f) (Arrow.mk f') → MarkovCong (Arrow.mk g) (Arrow.mk g') →
      MarkovCong (Arrow.mk (f ≫ g)) (Arrow.mk (f' ≫ g'))
  | tensor {a b c d a' b' c' d' : G.toFreeGraphMonoid.Syn} {f : a ⟶ b} {g : c ⟶ d}
      {f' : a' ⟶ b'} {g' : c' ⟶ d'} : MarkovCong (Arrow.mk f) (Arrow.mk f') →
      MarkovCong (Arrow.mk g) (Arrow.mk g') → MarkovCong (Arrow.mk (f ⊗ₛ g)) (Arrow.mk (f' ⊗ₛ g'))
  /-- (1.1), coassociativity. -/
  | copy_assoc (a : G.toFreeGraphMonoid.Syn) :
      MarkovCong (Arrow.mk (G.copyS a ≫ (G.copyS a ⊗ₛ 𝟙 a)))
        (Arrow.mk (G.copyS a ≫ (𝟙 a ⊗ₛ G.copyS a)))
  /-- (1.1), counitality. -/
  | discard_copy (a : G.toFreeGraphMonoid.Syn) :
      MarkovCong (Arrow.mk (G.copyS a ≫ (G.discardS a ⊗ₛ 𝟙 a))) (Arrow.mk (𝟙 a))
  /-- (1.1), counitality. -/
  | copy_discard (a : G.toFreeGraphMonoid.Syn) :
      MarkovCong (Arrow.mk (G.copyS a ≫ (𝟙 a ⊗ₛ G.discardS a))) (Arrow.mk (𝟙 a))
  /-- (1.1), cocommutativity. -/
  | copy_comm (a : G.toFreeGraphMonoid.Syn) :
      MarkovCong (Arrow.mk (G.copyS a ≫ σ_ a a)) (Arrow.mk (G.copyS a))
  /-- (1.2) for duplicates. -/
  | copy_tensor (a b : G.toFreeGraphMonoid.Syn) :
      MarkovCong (Arrow.mk (G.copyS (a * b)))
        (Arrow.mk ((G.copyS a ⊗ₛ G.copyS b) ≫
          eqToHom (by simp only [mul_assoc] : a * a * (b * b) = a * (a * b) * b) ≫
          ((𝟙 a ⊗ₛ σ_ a b) ⊗ₛ 𝟙 b)))
  /-- (1.2) for discards. -/
  | discard_tensor (a b : G.toFreeGraphMonoid.Syn) :
      MarkovCong (Arrow.mk (G.discardS (a * b))) (Arrow.mk (G.discardS a ⊗ₛ G.discardS b))
  /-- (1.3), naturality of discards. -/
  | discard_natural {a b : G.toFreeGraphMonoid.Syn} (f : a ⟶ b) :
      MarkovCong (Arrow.mk (f ≫ G.discardS b)) (Arrow.mk (G.discardS a))

variable {G}

/-- Every morphism into the unit is congruent to the discard (by (1.3) and `ε_1 = 1_1`). -/
theorem MarkovCong.to_one {a : G.toFreeGraphMonoid.Syn} (p : a ⟶ Syn.of G.toFreeGraphMonoid 1) :
    G.MarkovCong (Arrow.mk p) (Arrow.mk (G.discardS a)) := by
  have h := MarkovCong.discard_natural (G := G) p
  have e : p ≫ G.discardS (Syn.of G.toFreeGraphMonoid 1) = p := Category.comp_id p
  rwa [e] at h

/-! ### The kernel of a strict functor out of `Syn_s(G)` matching duplicates and discards -/

section Kernel

variable {D : Type u₁} [Monoid D] [Category.{v₁} D] [StrictMarkov D]
  (F : StrictFunctor G.toFreeGraphMonoid.Syn D)
  (hF : G.MatchesDupDisc (F.toGraphMonoidHom.comp (Syn.ι G.toFreeGraphMonoid)))
include hF

theorem map_dupS (x : S) :
    Arrow.mk (F.map (G.dupS x)) = Arrow.mk (δ_ (F.obj (Syn.of _ (FreeMonoid.of x)))) := by
  unfold dupS
  rw [Functor.map_comp, Functor.map_comp, eqToHom_map, eqToHom_map,
    Arrow.arrow_mk_eqToHom_comp, Arrow.arrow_mk_comp_eqToHom]
  exact hF.dup x

theorem map_copyS (a : G.toFreeGraphMonoid.Syn) :
    Arrow.mk (F.map (G.copyS a)) = Arrow.mk (δ_ (F.obj a)) := by
  suffices h : ∀ l : List S, Arrow.mk (F.map (G.copyL l)) =
      Arrow.mk (δ_ (F.obj (Syn.of _ (FreeMonoid.ofList l)))) from h (FreeMonoid.toList a)
  intro l
  induction l with
  | nil =>
    exact (congrArg Arrow.mk (F.map_id _)).trans
      ((Arrow.mk_id_congr F.obj_one).trans (copy_one.symm.trans
        (StrictMarkov.mk_copy_congr F.obj_one.symm)))
  | cons x l ih =>
    cases l with
    | nil => exact map_dupS F hF x
    | cons y l =>
      change Arrow.mk (F.map (((G.dupS x ⊗ₛ G.copyL (y :: l)) ≫ eqToHom _ ≫ _) ≫ eqToHom _)) = _
      rw [Functor.map_comp, eqToHom_map, Arrow.arrow_mk_comp_eqToHom]
      exact F.map_copy_formula _ _ (map_dupS F hF x) ih

omit hF in
theorem map_discardS (a : G.toFreeGraphMonoid.Syn) :
    Arrow.mk (F.map (G.discardS a)) = Arrow.mk (ε_ (F.obj a)) := by
  rw [← Arrow.arrow_mk_comp_eqToHom (F.map (G.discardS a)) F.obj_one,
    eq_discard (F.map (G.discardS a) ≫ _)]

omit hF in
theorem map_to_one {a : G.toFreeGraphMonoid.Syn} (p q : a ⟶ Syn.of _ 1) :
    Arrow.mk (F.map p) = Arrow.mk (F.map q) := by
  rw [← Arrow.arrow_mk_comp_eqToHom (F.map p) F.obj_one,
    ← Arrow.arrow_mk_comp_eqToHom (F.map q) F.obj_one, eq_discard (F.map p ≫ _),
    eq_discard (F.map q ≫ _)]

/-- **Soundness**: a strict functor out of `Syn_s(G)` into a strict Markov category that
matches duplicates and discards on the letters identifies congruent morphisms. -/
theorem MarkovCong.map_eq {p q : Arrow G.toFreeGraphMonoid.Syn} (h : G.MarkovCong p q) :
    Arrow.mk (F.map p.hom) = Arrow.mk (F.map q.hom) := by
  induction h with
  | refl => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih ih' => exact ih.trans ih'
  | comp _ _ ih ih' =>
    simp only [Arrow.mk_hom, Functor.map_comp] at ih ih' ⊢
    exact Arrow.mk_comp_congr ih ih'
  | tensor _ _ ih ih' =>
    simp only [Arrow.mk_hom] at ih ih' ⊢
    exact (F.map_tensorHom _ _).trans ((mk_tensorHom_congr ih ih').trans
      (F.map_tensorHom _ _).symm)
  | copy_assoc a =>
    simp only [Arrow.mk_hom, Functor.map_comp]
    refine (Arrow.mk_comp_congr (map_copyS F hF a) ((F.map_tensorHom _ _).trans
      (mk_tensorHom_congr (map_copyS F hF a) (congrArg Arrow.mk (F.map_id a))))).trans ?_
    refine Eq.trans ?_ (Arrow.mk_comp_congr (map_copyS F hF a) ((F.map_tensorHom _ _).trans
      (mk_tensorHom_congr (congrArg Arrow.mk (F.map_id a)) (map_copyS F hF a)))).symm
    exact StrictMarkov.copy_assoc _
  | discard_copy a =>
    simp only [Arrow.mk_hom, Functor.map_comp]
    refine (Arrow.mk_comp_congr (map_copyS F hF a) ((F.map_tensorHom _ _).trans
      (mk_tensorHom_congr (map_discardS F a) (congrArg Arrow.mk (F.map_id a))))).trans ?_
    exact (StrictMarkov.discard_copy _).trans (congrArg Arrow.mk (F.map_id a)).symm
  | copy_discard a =>
    simp only [Arrow.mk_hom, Functor.map_comp]
    refine (Arrow.mk_comp_congr (map_copyS F hF a) ((F.map_tensorHom _ _).trans
      (mk_tensorHom_congr (congrArg Arrow.mk (F.map_id a)) (map_discardS F a)))).trans ?_
    exact (StrictMarkov.copy_discard _).trans (congrArg Arrow.mk (F.map_id a)).symm
  | copy_comm a =>
    simp only [Arrow.mk_hom, Functor.map_comp]
    refine (Arrow.mk_comp_congr (map_copyS F hF a) (F.map_braid a a)).trans ?_
    exact (congrArg Arrow.mk (StrictMarkov.copy_comm _)).trans (map_copyS F hF a).symm
  | copy_tensor a b =>
    simp only [Arrow.mk_hom]
    exact (map_copyS F hF (a * b)).trans
      (F.map_copy_formula _ _ (map_copyS F hF a) (map_copyS F hF b)).symm
  | discard_tensor a b => exact map_to_one F _ _
  | discard_natural f => exact map_to_one F _ _

end Kernel

end FreeDDGraphMonoid

/-! ### Remark 4.2 -/

namespace JoyalStreet

variable {G : FreeDDGraphMonoid.{w, v} S} (J : JoyalStreet G.toFreeGraphMonoid)

open FreeDDGraphMonoid

/-- The composite `Syn_s(G) → F_s(G) → F_s(G) / S_M`. -/
noncomputable def synToM : StrictFunctor G.toFreeGraphMonoid.Syn J.FsM :=
  (J.quotProjStrict _ _).comp J.toFsStrict

theorem synToM_comp_ι : (J.synToM).toGraphMonoidHom.comp (Syn.ι G.toFreeGraphMonoid) = J.iM := by
  change (J.quotProjStrict _ _).toGraphMonoidHom.comp
    (J.toFsStrict.toGraphMonoidHom.comp (Syn.ι G.toFreeGraphMonoid)) = _
  rw [toFsStrict_comp_ι]
  rfl

theorem ofFs_hom_ofClass_tensor (c d : DClass G.toFreeGraphMonoid) :
    Arrow.mk (J.ofFsStrict.map (J.hom (DHom.ofClass (c.tensor d)))) =
      Arrow.mk (J.ofFsStrict.map (J.hom (DHom.ofClass c)) ⊗ₛ
        J.ofFsStrict.map (J.hom (DHom.ofClass d))) :=
  (J.ofFsStrict.toFunctor.mk_map_congr (J.arrow_eq_of_cls_eq
    (f := J.hom (DHom.ofClass (c.tensor d)))
    (g := J.hom (DHom.ofClass c) ⊗ₛ J.hom (DHom.ofClass d)) rfl)).trans
    (J.ofFsStrict.map_tensorHom _ _)

theorem ofFs_hom_cast (d : DClass G.toFreeGraphMonoid) {a : FreeMonoid S} (h : d.dom = a) :
    Arrow.mk (J.ofFsStrict.map (J.hom ((DHom.ofClass d).cast h rfl))) =
      Arrow.mk (J.ofFsStrict.map (J.hom (DHom.ofClass d))) :=
  J.ofFsStrict.toFunctor.mk_map_congr (J.arrow_eq_of_cls_eq rfl)

theorem ofFs_hom_ofClass_comp (c d : DClass G.toFreeGraphMonoid) (h : c.cod = d.dom) :
    Arrow.mk (J.ofFsStrict.map (J.hom (DHom.ofClass (c.comp d)))) =
      Arrow.mk (J.ofFsStrict.map (J.hom (DHom.ofClass c)) ≫
        J.ofFsStrict.map (J.hom ((DHom.ofClass d).cast h.symm rfl))) :=
  (J.ofFsStrict.toFunctor.mk_map_congr (J.arrow_eq_of_cls_eq
    (f := J.hom (DHom.ofClass (c.comp d)))
    (g := J.hom (DHom.ofClass c) ≫ J.hom ((DHom.ofClass d).cast h.symm rfl)) rfl)).trans
    (congrArg Arrow.mk (J.ofFsStrict.map_comp _ _))

theorem ofFs_hom {a b : FreeMonoid S} (g : DHom G.toFreeGraphMonoid a b) :
    Arrow.mk (J.ofFsStrict.map (J.hom (DHom.ofClass g.1))) =
      Arrow.mk (J.ofFsStrict.map (J.hom g)) :=
  J.ofFsStrict.toFunctor.mk_map_congr (J.arrow_eq_of_cls_eq rfl)

theorem ofFs_gen (x : G.A) :
    Arrow.mk (J.ofFsStrict.map (J.hom (DHom.gen x))) = Arrow.mk (Syn.gen x) :=
  congrArg (fun φ => φ.A x) (J.ofFsStrict_comp_ι)

theorem ofFs_dupH (x : S) :
    Arrow.mk (J.ofFsStrict.map (J.hom (G.dupH x))) = Arrow.mk (G.dupS x) := by
  refine (J.ofFs_hom (G.dupH x)).symm.trans ((J.ofFs_hom (DHom.gen (G.dup x))).trans
    ((J.ofFs_gen _).trans ?_))
  unfold dupS
  rw [Arrow.arrow_mk_eqToHom_comp, Arrow.arrow_mk_comp_eqToHom]

theorem ofFs_discH (x : S) :
    Arrow.mk (J.ofFsStrict.map (J.hom (G.discH x))) = Arrow.mk (G.discS x) := by
  refine (J.ofFs_hom (G.discH x)).symm.trans ((J.ofFs_hom (DHom.gen (G.disc x))).trans
    ((J.ofFs_gen _).trans ?_))
  unfold discS
  rw [Arrow.arrow_mk_eqToHom_comp, Arrow.arrow_mk_comp_eqToHom]

theorem ofFs_id (a : FreeMonoid S) :
    Arrow.mk (J.ofFsStrict.map (J.hom (DHom.id _ a))) = Arrow.mk (𝟙 (Syn.of _ a)) :=
  congrArg Arrow.mk (J.ofFsStrict.map_id _)

/-- The relation on classes read back in `Syn_s(G)`: the corresponding terms are
congruent. -/
def synRel (c d : DClass G.toFreeGraphMonoid) : Prop :=
  G.MarkovCong (Arrow.mk (J.ofFsStrict.map (J.hom (DHom.ofClass c))))
    (Arrow.mk (J.ofFsStrict.map (J.hom (DHom.ofClass d))))

theorem synRel_pair {c d : DClass G.toFreeGraphMonoid} (h : G.MarkovPair c d) : J.synRel c d := by
  unfold synRel
  cases h with
  | coass x =>
    rw [G.mk_coassΩD, G.mk_coassΛD, J.ofFs_hom, J.ofFs_hom]
    rw [show Arrow.mk (J.ofFsStrict.map (J.hom (G.coassΩ x))) =
        Arrow.mk (G.copyS (Syn.of _ (FreeMonoid.of x)) ≫
          (G.copyS (Syn.of _ (FreeMonoid.of x)) ⊗ₛ 𝟙 (Syn.of _ (FreeMonoid.of x)))) from
      (congrArg Arrow.mk (J.ofFsStrict.map_comp (J.hom (G.dupH x))
        (J.hom ((G.dupH x).tensor (DHom.id _ _))))).trans
      (Arrow.mk_comp_congr (J.ofFs_dupH x) ((J.ofFsStrict.map_tensorHom _ _).trans
        (mk_tensorHom_congr (J.ofFs_dupH x) (J.ofFs_id _))))]
    rw [show Arrow.mk (J.ofFsStrict.map (J.hom (G.coassΛ x))) =
        Arrow.mk (G.copyS (Syn.of _ (FreeMonoid.of x)) ≫
          (𝟙 (Syn.of _ (FreeMonoid.of x)) ⊗ₛ G.copyS (Syn.of _ (FreeMonoid.of x)))) from
      (congrArg Arrow.mk (J.ofFsStrict.map_comp (J.hom (G.dupH x))
        (J.hom ((DHom.id _ _).tensor (G.dupH x))))).trans
      (Arrow.mk_comp_congr (J.ofFs_dupH x) ((J.ofFsStrict.map_tensorHom _ _).trans
        (mk_tensorHom_congr (J.ofFs_id _) (J.ofFs_dupH x))))]
    exact MarkovCong.copy_assoc _
  | counit x =>
    rw [G.mk_counitΩD, show DClass.mk (G.idDa x) = (DHom.id _ (FreeMonoid.of x)).1 from rfl]
    rw [J.ofFs_hom, J.ofFs_hom (DHom.id _ _), J.ofFs_id]
    rw [show Arrow.mk (J.ofFsStrict.map (J.hom (G.counitΩ x))) =
        Arrow.mk (G.copyS (Syn.of _ (FreeMonoid.of x)) ≫
          (𝟙 (Syn.of _ (FreeMonoid.of x)) ⊗ₛ G.discardS (Syn.of _ (FreeMonoid.of x)))) from
      (congrArg Arrow.mk (J.ofFsStrict.map_comp (J.hom (G.dupH x))
        (J.hom ((DHom.id _ _).tensor (G.discH x))))).trans
      (Arrow.mk_comp_congr (J.ofFs_dupH x) ((J.ofFsStrict.map_tensorHom _ _).trans
        (mk_tensorHom_congr (J.ofFs_id _) (J.ofFs_discH x))))]
    exact MarkovCong.copy_discard _
  | counit' x =>
    rw [G.mk_counitΩ'D, show DClass.mk (G.idDa x) = (DHom.id _ (FreeMonoid.of x)).1 from rfl]
    rw [J.ofFs_hom, J.ofFs_hom (DHom.id _ _), J.ofFs_id]
    rw [show Arrow.mk (J.ofFsStrict.map (J.hom (G.counitΩ' x))) =
        Arrow.mk (G.copyS (Syn.of _ (FreeMonoid.of x)) ≫
          (G.discardS (Syn.of _ (FreeMonoid.of x)) ⊗ₛ 𝟙 (Syn.of _ (FreeMonoid.of x)))) from
      (congrArg Arrow.mk (J.ofFsStrict.map_comp (J.hom (G.dupH x))
        (J.hom ((G.discH x).tensor (DHom.id _ _))))).trans
      (Arrow.mk_comp_congr (J.ofFs_dupH x) ((J.ofFsStrict.map_tensorHom _ _).trans
        (mk_tensorHom_congr (J.ofFs_discH x) (J.ofFs_id _))))]
    exact MarkovCong.discard_copy _
  | cocomm x =>
    rw [G.mk_cocommΩD, show DClass.mk (G.dupD x) = (G.dupH x).1 from rfl]
    rw [J.ofFs_hom, J.ofFs_hom (G.dupH x), J.ofFs_dupH]
    rw [show Arrow.mk (J.ofFsStrict.map (J.hom (G.cocommΩ x))) =
        Arrow.mk (G.copyS (Syn.of _ (FreeMonoid.of x)) ≫
          σ_ (Syn.of _ (FreeMonoid.of x)) (Syn.of _ (FreeMonoid.of x))) from
      (congrArg Arrow.mk (J.ofFsStrict.map_comp (J.hom (G.dupH x))
        (σ_ (Fs.of J (FreeMonoid.of x)) (Fs.of J (FreeMonoid.of x))))).trans
      (Arrow.mk_comp_congr (J.ofFs_dupH x) (J.ofFsStrict.map_braid _ _))]
    exact MarkovCong.copy_comm _
  | nat x =>
    rw [G.mk_natΩD, G.mk_natΛD, J.ofFs_hom, J.ofFs_hom]
    exact (MarkovCong.to_one _).trans (MarkovCong.to_one _).symm

theorem synRel_of_sRel {c d : DClass G.toFreeGraphMonoid} (h : SRel G.markovTemplates c d) :
    J.synRel c d := by
  refine (sRelClosed_markov (K := J.synRel) (fun _ => MarkovCong.refl _)
    (fun h h' => MarkovCong.trans h h') ?_ ?_
    (fun h => ⟨J.synRel_pair h, MarkovCong.symm (J.synRel_pair h)⟩)).of_sRel h
  · intro c c' d d' h₁ h₂
    unfold synRel
    rw [J.ofFs_hom_ofClass_tensor, J.ofFs_hom_ofClass_tensor]
    exact MarkovCong.tensor h₁ h₂
  · intro c c' d d' h₁ h₂ h h'
    unfold synRel
    rw [J.ofFs_hom_ofClass_comp c d h, J.ofFs_hom_ofClass_comp c' d' h']
    refine MarkovCong.comp h₁ ?_
    unfold synRel at h₂
    rwa [J.ofFs_hom_cast, J.ofFs_hom_cast]

/-- **Remark 4.2.** Two parallel morphisms `f`, `g` of `Syn_s(G)` (terms of the symbolic
language of symmetric monoidal categories over `G`) are congruent modulo the axioms of
Markov categories if and only if their diagrams are related by Markov surgeries, that is,
have the same image in `F_s(G) / S_M`. -/
theorem remark_4_2 {a b : G.toFreeGraphMonoid.Syn} (f g : a ⟶ b) :
    G.MarkovCong (Arrow.mk f) (Arrow.mk g) ↔ J.synToM.map f = J.synToM.map g := by
  constructor
  · intro h
    exact Arrow.eq_of_mk_eq (MarkovCong.map_eq J.synToM (J.synToM_comp_ι ▸ J.iM_matches) h)
  · intro h
    have hS := (J.quotProj_map_eq_iff _ _ (J.toFs.map f) (J.toFs.map g)).1 h
    have hK := J.synRel_of_sRel hS
    unfold synRel at hK
    have e : ∀ f : a ⟶ b, Arrow.mk (J.ofFsStrict.map (J.hom (DHom.ofClass (J.cls (J.toFs.map f))))) =
        Arrow.mk f := fun f =>
      (J.ofFsStrict.toFunctor.mk_map_congr (J.arrow_eq_of_cls_eq
        (f := J.hom (DHom.ofClass (J.cls (J.toFs.map f)))) (g := J.toFs.map f) rfl)).trans
        (congrArg Arrow.mk ((J.equiv a b).symm_apply_apply f))
    rwa [e f, e g] at hK

/-- With `remark_4_2`: every morphism of `F_s(G) / S_M` comes from `Syn_s(G)`, so
`Syn_s(G) / MarkovCong ≅ F_s(G) / S_M`. -/
theorem remark_4_2_surjective {a b : J.FsM} (φ : a ⟶ b) :
    ∃ f : (Syn.of G.toFreeGraphMonoid a ⟶ Syn.of G.toFreeGraphMonoid b), J.synToM.map f = φ := by
  induction φ using Quotient.ind with
  | _ g =>
  exact ⟨(J.equiv a b).symm g, congrArg (Quotient.mk _) ((J.equiv a b).apply_symm_apply g)⟩

include J in
/-- **Remark 4.2, semantic form.** Two parallel morphisms of `Syn_s(G)` are congruent modulo
the axioms of Markov categories if and only if they have the same value under every graph
monoid homomorphism `G → D` into a strict Markov category matching duplicates and discards
(here `D` ranges over the universes of `F_s(G) / S_M`; the "only if" holds for all). -/
theorem remark_4_2_semantic {a b : G.toFreeGraphMonoid.Syn} (f g : a ⟶ b) :
    G.MarkovCong (Arrow.mk f) (Arrow.mk g) ↔
      ∀ (D : Type w) [Monoid D] [Category.{max w v} D] [StrictMarkov D]
        (φ : G.toGraphMonoid.Hom (graphMonoid D)), G.MatchesDupDisc φ →
          Arrow.mk ((Syn.lift φ).map f) = Arrow.mk ((Syn.lift φ).map g) := by
  constructor
  · intro h D _ _ _ φ hφ
    exact MarkovCong.map_eq (Syn.lift φ) ((Syn.lift_comp_ι φ).symm ▸ hφ) h
  · intro h
    have hl : Syn.lift J.iM = J.synToM := (Syn.eq_lift J.iM J.synToM_comp_ι).symm
    have := h J.FsM J.iM J.iM_matches
    rw [hl] at this
    exact (J.remark_4_2 f g).2 (Arrow.eq_of_mk_eq this)

