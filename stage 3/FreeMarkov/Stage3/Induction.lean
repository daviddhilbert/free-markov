/-
Free Markov categories, Stage 3: an induction principle for `S_T`.

Corollary 3.5 says that `S_T` is the monoidal congruence generated by the pairs
`([Ω], [Λ])` of the templates in `T`, for *all* orderings of the domains and codomains of
`Ω` compatible with `α`, `β`.  The proof of `S_T ⊆ E_T` (Stage 2, `TStep.toERel`) uses only
one ordering of `Ω`, which may be chosen freely.  So a relation that is reflexive,
transitive, compatible with `⊗` and `∘`, and contains the pair of each template for *one*
ordering of its choice already contains `S_T`.  This is what the paper uses when it says
that "`F_s` sends the two diagrams of each Markov template to the two sides of an
instance of one of the equalities" and concludes, by Corollary 3.5, that `F_s` is constant
on `S_M`-classes.  No cited result is used.
-/
module

public import FreeMarkov.Stage3.Templates

@[expose] public section

universe u w v u₁ u₂

namespace FreeMarkov

open CategoryTheory Relation Diagram

variable {S : Type w} {G : FreeGraphMonoid.{w, v} S} {T : Set (Template.{u} G)}

/-- The hypotheses on a relation `K` on classes under which `S_T ⊆ K`: `K` is reflexive,
transitive, compatible with `⊗` and `∘`, and contains, for each template of `T`, its
pair `([Ω], [Λ])` for at least one ordering of the domain and codomain of `Ω`. -/
structure SRelClosed (T : Set (Template.{u} G)) (K : DClass G → DClass G → Prop) : Prop where
  refl : ∀ c, K c c
  trans : ∀ {c d e}, K c d → K d e → K c e
  tensor : ∀ {c c' d d'}, K c c' → K d d' → K (c.tensor d) (c'.tensor d')
  comp : ∀ {c c' d d'}, K c c' → K d d' → c.cod = d.dom → c'.cod = d'.dom →
    K (c.comp d) (c'.comp d')
  gen : ∀ τ ∈ T, ∃ (dΩ : Enumeration τ.Ω.IsDom) (cΩ : Enumeration τ.Ω.IsCod),
    K (DClass.mk (τ.Ω.anchor dΩ cΩ))
      (DClass.mk (τ.Λ.anchor (dΩ.mapEquiv τ.α.symm) (cΩ.mapEquiv τ.β.symm)))

namespace SRelClosed

variable {K : DClass G → DClass G → Prop} (hK : SRelClosed T K)
include hK

/-- A `T`-surgery step is in `K` (the proof of `TStep.toERel`, with the ordering of `Ω`
chosen by `K`). -/
theorem of_tStep {N E : Type} [Finite N] [Finite E] {N' : Type u₁} {E' : Type u₂}
    [Finite N'] [Finite E'] {Γ : Diagram G N E} {Ξ : Diagram G N' E'} (h : TStep T Γ Ξ) :
    K (DClass.mk Γ) (DClass.mk Ξ) := by
  obtain ⟨τ, hτ, A, hA, φ, ⟨i⟩⟩ := h
  obtain ⟨d₀, c₀, hgen⟩ := hK.gen τ hτ
  set V := hA.sharpLayer
  let ρ : Enumeration fun _ : V.R => True := Enumeration.ofFinite _
  have e₁ := Γ.mk_eq_decomp V φ (d₀.plus ρ) (c₀.plusc ρ)
  have e₂ := Γ.mk_surgeryAt_eq_decomp V φ τ.α τ.β τ.hα τ.hβ (d₀.plus ρ) (c₀.plusc ρ)
  have hM : DClass.mk (Γ.midΩ V (d₀.plus ρ) (c₀.plusc ρ)) =
      (DClass.mk (τ.Ω.anchor d₀ c₀)).tensor (DClass.mk (nodeFreeOf (Γ.rLabel V) ρ)) := by
    rw [DClass.mk_tensor]
    exact DClass.mk_eq_mk (plusIso _ _ _ _ _)
  have hMΛ : DClass.mk (Γ.midΛ V τ.α τ.β (d₀.plus ρ) (c₀.plusc ρ)) =
      (DClass.mk (τ.Λ.anchor (d₀.mapEquiv τ.α.symm) (c₀.mapEquiv τ.β.symm))).tensor
        (DClass.mk (nodeFreeOf (Γ.rLabel V) ρ)) := by
    change DClass.mk ((τ.Λ.addLoose (Γ.rLabel V)).anchor
      ((d₀.plus ρ).mapEquiv (PGraph.liftDom τ.α V.R).symm)
      ((c₀.plusc ρ).mapEquiv (PGraph.liftCod τ.β V.R).symm)) = _
    rw [← Enumeration.plus_liftDom, ← Enumeration.plusc_liftCod, DClass.mk_tensor]
    exact DClass.mk_eq_mk (plusIso _ _ _ _ _)
  have egen : ERel T (DClass.mk (τ.Ω.anchor d₀ c₀))
      (DClass.mk (τ.Λ.anchor (d₀.mapEquiv τ.α.symm) (c₀.mapEquiv τ.β.symm))) :=
    ERel.gen hτ d₀ c₀ _ _ (by rw [Enumeration.mapEquiv_mapEquiv, Equiv.symm_trans_self,
      Enumeration.mapEquiv_refl]) (by rw [Enumeration.mapEquiv_mapEquiv, Equiv.symm_trans_self,
      Enumeration.mapEquiv_refl])
  have et := ERel.tensor egen (ERel.refl (DClass.mk (nodeFreeOf (Γ.rLabel V) ρ)))
  have ht := hK.tensor hgen (hK.refl (DClass.mk (nodeFreeOf (Γ.rLabel V) ρ)))
  rw [← hM, ← hMΛ] at ht et
  have hgM : (DClass.mk (Γ.lowerA V φ (d₀.plus ρ))).cod =
      (DClass.mk (Γ.midΩ V (d₀.plus ρ) (c₀.plusc ρ))).dom := by
    rw [DClass.cod_mk, DClass.dom_mk]
    exact Γ.lowerA_codWord V φ _ _
  have hMh : (DClass.mk (Γ.midΩ V (d₀.plus ρ) (c₀.plusc ρ))).cod =
      (DClass.mk (Γ.upperA V φ (c₀.plusc ρ))).dom := by
    rw [DClass.cod_mk, DClass.dom_mk]
    exact Γ.midΩ_codWord V φ _ _
  have hpar := et.dom_eq_cod_eq
  rw [e₁, ← DClass.mk_eq_mk i, e₂]
  refine hK.comp (hK.comp (hK.refl _) ht hgM (hgM.trans hpar.1.symm)) (hK.refl _) ?_ ?_
  · rw [DClass.cod_comp hgM]
    exact hMh
  · rw [DClass.cod_comp (hgM.trans hpar.1.symm), hpar.2]
    exact hMh

/-- **`S_T ⊆ K`** for every relation `K` satisfying `SRelClosed T K`. -/
theorem of_sRel {c d : DClass G} (h : SRel T c d) : K c d := by
  obtain ⟨a, b, rfl, rfl, h⟩ := h
  induction h with
  | refl => exact hK.refl _
  | @tail b c _ hbc ih =>
    refine hK.trans ih ?_
    rw [DClass.mk_fin b, DClass.mk_fin c]
    exact hK.of_tStep hbc

end SRelClosed

end FreeMarkov
