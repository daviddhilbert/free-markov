/-
Free Markov categories, Stage 4: **Lemma 4.4**.

"Every `S_M`-congruence class contains a Markov minimal diagram, and any two Markov minimal diagrams
with the same skeleton are Markov congruent. Consequently, two anchored diagrams in `G` with the same
domain and the same codomain belong to the same `S_M`-congruence class if and only if they have the
same skeleton, and any two Markov minimal diagrams in the same `S_M`-congruence class are Markov
congruent."

* `lemma_4_4_exists_minimal` (in `ExistsMinimal.lean`), `lemma_4_4_congruent`, `lemma_4_4_iff`,
  `lemma_4_4_minimal_congruent`; `lemma_4_4` collects them.
* `JoyalStreet.projM_map_eq_iff`: the form used in the application — two morphisms of `F_s(G)`
  represented by diagrams have the same image in `F_s(G)/S_M` iff the diagrams have the same
  skeleton.

Only the last statement uses the cited result C1 (through the quotient category `F_s(G)/S_M`).
-/
module

public import FreeMarkov.Stage4.CodingF

@[expose] public section

universe w v u₁ u₂ u₃ u₄

namespace FreeMarkov

open Relation

namespace Diagram

variable {S : Type w} {G : FreeDDGraphMonoid.{w, v} S} {N : Type u₁} {E : Type u₂}
  {N' : Type u₃} {E' : Type u₄}

/-- **Markov congruent** (Section 4): "`Υ` is Markov congruent to `Γ` if they become isomorphic upon
surgeries with the templates (4.1), (4.3)", i.e. they are related by the equivalence generated by
surgeries with (4.1), (4.3) and their reverses (`S_T` for `T` = `congTemplates`). -/
def MarkovCongruent [Finite N] [Finite E] [Finite N'] [Finite E'] (Γ : Diagram G.toFreeGraphMonoid N E)
    (Υ : Diagram G.toFreeGraphMonoid N' E') : Prop :=
  SRel G.congTemplates (DClass.mk Γ) (DClass.mk Υ)

theorem SRel.mono {T T' : Set (Template.{0} G.toFreeGraphMonoid)} (hT : T ⊆ T')
    {c d : DClass G.toFreeGraphMonoid} (h : SRel T c d) : SRel T' c d := by
  obtain ⟨a, b, ha, hb, hab⟩ := h
  refine ⟨a, b, ha, hb, ?_⟩
  clear ha hb
  induction hab with
  | refl => exact ReflTransGen.refl
  | tail _ h ih => exact ih.tail (h.mono hT)

theorem sRel_of_moves [Finite N] [Finite E] {X Y : Diagram G.toFreeGraphMonoid N E}
    (h : ReflTransGen MoveRel X Y) : SRel G.congTemplates (DClass.mk X) (DClass.mk Y) := by
  induction h with
  | refl => exact SRel.refl _
  | tail _ h ih => exact ih.trans G.congTemplates_isSymmetric.empty_mem (SRel.of_tStep h.tstep)

/-- **Lemma 4.4, second claim.** Any two Markov minimal diagrams with the same skeleton are Markov
congruent. -/
theorem lemma_4_4_congruent [Finite N] [Finite E] [Finite N'] [Finite E']
    {Γ : Diagram G.toFreeGraphMonoid N E} {Υ : Diagram G.toFreeGraphMonoid N' E'}
    (hΓ : Γ.MarkovMinimal) (hΥ : Υ.MarkovMinimal) (h : SameSkeleton Γ Υ) : MarkovCongruent Γ Υ := by
  classical
  have := Fintype.ofFinite N
  have := Fintype.ofFinite E
  have := Fintype.ofFinite N'
  have := Fintype.ofFinite E'
  obtain ⟨hd, hc, π, hπ⟩ := h
  -- ranks that agree on corresponding consumers
  let ιX := Fintype.equivFin E
  let ιY := Fintype.equivFin E'
  let rkX : E → ℕ := fun e => 2 * (ιX e : ℕ)
  let rkY : E' → ℕ := fun e' =>
    if h : ∃ c, ConsCorr π c e' then 2 * (ιX h.choose : ℕ) else 2 * (ιY e' : ℕ) + 1
  have hrkX : Function.Injective rkX := fun e₁ e₂ h => by
    have : (ιX e₁ : ℕ) = ιX e₂ := by simp only [rkX] at h; omega
    exact ιX.injective (Fin.ext this)
  have hrkY : Function.Injective rkY := by
    intro e₁ e₂ h
    simp only [rkY] at h
    split_ifs at h with h₁ h₂ h₂
    · have : (ιX h₁.choose : ℕ) = ιX h₂.choose := by omega
      have hc' : h₁.choose = h₂.choose := ιX.injective (Fin.ext this)
      exact consCorr_unique h₁.choose_spec (hc' ▸ h₂.choose_spec)
    · omega
    · omega
    · have : (ιY e₁ : ℕ) = ιY e₂ := by omega
      exact ιY.injective (Fin.ext this)
  have hrk : ∀ c c', ConsCorr π c c' → rkY c' = rkX c := by
    intro c c' hcc
    have h₁ : ∃ c₀, ConsCorr π c₀ c' := ⟨c, hcc⟩
    simp only [rkY, rkX, dite_eq_left h₁]
    rw [consCorr_unique' h₁.choose_spec hcc]
  -- normalise both diagrams
  obtain ⟨Γ', hΓΓ', hΓm, hΓc, hΓs⟩ := normalize rkX hrkX Γ hΓ
  obtain ⟨Υ', hΥΥ', hΥm, hΥc, hΥs⟩ := normalize rkY hrkY Υ hΥ
  have cΓ := MoveRel.chain hΓΓ'
  have cΥ := MoveRel.chain hΥΥ'
  have hd' : Γ'.domWord = Υ'.domWord := by
    unfold domWord; rw [show Γ'.dom = Γ.dom from cΓ.dom, show Υ'.dom = Υ.dom from cΥ.dom,
      show Γ'.val.v₀ = Γ.val.v₀ from cΓ.v₀, show Υ'.val.v₀ = Υ.val.v₀ from cΥ.v₀]; exact hd
  have hc' : Γ'.codWord = Υ'.codWord := by
    unfold codWord; rw [show Γ'.cod = Γ.cod from cΓ.cod, show Υ'.cod = Υ.cod from cΥ.cod,
      show Γ'.val.v₀ = Γ.val.v₀ from cΓ.v₀, show Υ'.val.v₀ = Υ.val.v₀ from cΥ.v₀]; exact hc
  have hπ' := hπ.of_moves hΓΓ' hΥΥ'
  obtain ⟨i⟩ := iso_of_sorted hd' hc' hπ' (fun c c' hcc => hrk c c' ((consCorr_of_moves hΓΓ' hΥΥ').1 hcc))
    hΓm hΓc hΓs hrkX hΥm hΥc hΥs hrkY
  have h₁ := sRel_of_moves hΓΓ'
  have h₂ := sRel_of_moves hΥΥ'
  rw [DClass.mk_eq_mk i] at h₁
  exact h₁.trans G.congTemplates_isSymmetric.empty_mem (h₂.symm G.congTemplates_isSymmetric.symm_mem)

/-- **Lemma 4.4, completeness.** Two anchored diagrams with the same domain and the same codomain
belong to the same `S_M`-congruence class if and only if they have the same skeleton. -/
theorem lemma_4_4_iff [Finite N] [Finite E] [Finite N'] [Finite E']
    {Γ : Diagram G.toFreeGraphMonoid N E} {Υ : Diagram G.toFreeGraphMonoid N' E'} :
    SRel G.markovTemplates (DClass.mk Γ) (DClass.mk Υ) ↔ SameSkeleton Γ Υ := by
  refine ⟨lemma_4_3_sameSkeleton, fun h => ?_⟩
  have hT := G.markovTemplates_isSymmetric
  obtain ⟨n, m, Γ₀, hΓ₀, hΓΓ₀⟩ := lemma_4_4_exists_minimal (DClass.mk Γ)
  obtain ⟨n', m', Υ₀, hΥ₀, hΥΥ₀⟩ := lemma_4_4_exists_minimal (DClass.mk Υ)
  have hs : SameSkeleton Γ₀ Υ₀ :=
    ((lemma_4_3_sameSkeleton hΓΓ₀).symm.trans h).trans (lemma_4_3_sameSkeleton hΥΥ₀)
  have hc := SRel.mono G.congTemplates_subset (lemma_4_4_congruent hΓ₀ hΥ₀ hs)
  exact (hΓΓ₀.trans hT.empty_mem hc).trans hT.empty_mem (hΥΥ₀.symm hT.symm_mem)

/-- **Lemma 4.4, last claim.** Any two Markov minimal diagrams in the same `S_M`-congruence class are
Markov congruent. -/
theorem lemma_4_4_minimal_congruent [Finite N] [Finite E] [Finite N'] [Finite E']
    {Γ : Diagram G.toFreeGraphMonoid N E} {Υ : Diagram G.toFreeGraphMonoid N' E'}
    (hΓ : Γ.MarkovMinimal) (hΥ : Υ.MarkovMinimal)
    (h : SRel G.markovTemplates (DClass.mk Γ) (DClass.mk Υ)) : MarkovCongruent Γ Υ :=
  lemma_4_4_congruent hΓ hΥ (lemma_4_3_sameSkeleton h)

/-- **Lemma 4.4.** The four claims together. -/
theorem lemma_4_4 :
    (∀ c : DClass G.toFreeGraphMonoid, ∃ (n m : ℕ) (Υ : Diagram G.toFreeGraphMonoid (Fin n) (Fin m)),
      Υ.MarkovMinimal ∧ SRel G.markovTemplates c (DClass.mk Υ)) ∧
    (∀ {N : Type u₁} {E : Type u₂} {N' : Type u₃} {E' : Type u₄} [Finite N] [Finite E] [Finite N']
      [Finite E'] (Γ : Diagram G.toFreeGraphMonoid N E) (Υ : Diagram G.toFreeGraphMonoid N' E'),
      Γ.MarkovMinimal → Υ.MarkovMinimal → SameSkeleton Γ Υ → MarkovCongruent Γ Υ) ∧
    (∀ {N : Type u₁} {E : Type u₂} {N' : Type u₃} {E' : Type u₄} [Finite N] [Finite E] [Finite N']
      [Finite E'] (Γ : Diagram G.toFreeGraphMonoid N E) (Υ : Diagram G.toFreeGraphMonoid N' E'),
      SRel G.markovTemplates (DClass.mk Γ) (DClass.mk Υ) ↔ SameSkeleton Γ Υ) ∧
    (∀ {N : Type u₁} {E : Type u₂} {N' : Type u₃} {E' : Type u₄} [Finite N] [Finite E] [Finite N']
      [Finite E'] (Γ : Diagram G.toFreeGraphMonoid N E) (Υ : Diagram G.toFreeGraphMonoid N' E'),
      Γ.MarkovMinimal → Υ.MarkovMinimal → SRel G.markovTemplates (DClass.mk Γ) (DClass.mk Υ) →
        MarkovCongruent Γ Υ) :=
  ⟨lemma_4_4_exists_minimal, fun _ _ => lemma_4_4_congruent, fun _ _ => lemma_4_4_iff,
    fun _ _ => lemma_4_4_minimal_congruent⟩

end Diagram

namespace JoyalStreet

variable {S : Type w} {G : FreeDDGraphMonoid.{w, v} S} (J : JoyalStreet G.toFreeGraphMonoid)
  {N : Type u₁} {E : Type u₂} {N' : Type u₃} {E' : Type u₄}

/-- **Lemma 4.4 for morphisms of `F_s(G)`** ("coherence of the graphical language"): two morphisms
of `F_s(G)` represented by the diagrams `Γ`, `Υ` have the same image in `F_s(G) / S_M` iff `Γ` and
`Υ` have the same skeleton. -/
theorem projM_map_eq_iff [Finite N] [Finite E] [Finite N'] [Finite E'] {a b : J.Fs} (f g : a ⟶ b)
    {Γ : Diagram G.toFreeGraphMonoid N E} {Υ : Diagram G.toFreeGraphMonoid N' E'}
    (hf : J.cls f = DClass.mk Γ) (hg : J.cls g = DClass.mk Υ) :
    J.projM.map f = J.projM.map g ↔ Diagram.SameSkeleton Γ Υ := by
  rw [quotProj_map_eq_iff, hf, hg]
  exact Diagram.lemma_4_4_iff

end JoyalStreet

end FreeMarkov
